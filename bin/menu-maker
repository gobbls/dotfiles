#!/usr/bin/env bash

#
# Creates a TUI checkbox menu for users to navigate and check items.
# Default behaviour returns all the checked items.
#
# `--unchecked` returun all UNCHECKED items instead.
# `--all-checked` checks all items in the list.
#

UNCHECKED_SYMBOL="[ ]"
CHECKED_SYMBOL="[x]"

return_unchecked=1
check_all=1
items=()
unchecked=()
checked=()
hover_idx=0

function shift_hover_idx() {
    local direction="$1"
    if [[ $direction == "up" ]]; then
        ((hover_idx--))
        [[ $hover_idx -lt 0 ]] && hover_idx=$((${#items[@]} - 1))
    elif [[ $direction == "down" ]]; then
        ((hover_idx++))
        [[ $hover_idx -gt $((${#items[@]} - 1)) ]] && hover_idx=0
    fi
}

function in_list() {
    local search_item="$1"
    shift 1
    local list=("$@")
    for i in "${list[@]}"; do
        [[ "$search_item" == "$i" ]] && return 0
    done
    return 1
}

function index_of_list_item() {
    local search_item="$1"
    shift 1
    local list=("$@")
    for i in "${!list[@]}"; do
        if [[ "$search_item" == "${list[i]}" ]];then
            echo "$i"
            return 0
        fi
    done
    exit 1
}

function add_remove_selection() {
    local item="${items[$hover_idx]}"
    local item_idx=
    if in_list "$item" "${checked[@]}"; then
        unchecked+=("$item")
        item_idx=$(index_of_list_item "$item" "${checked[@]}")
        unset "checked[item_idx]"
        checked=("${checked[@]}")
    else
        checked+=("$item")
        item_idx=$(index_of_list_item "$item" "${unchecked[@]}")
        unset "unchecked[item_idx]"
        unchecked=("${unchecked[@]}")
    fi
}

function highlight() {
    echo -e "\e[30;47m${1}\e[0m" > /dev/tty
}

function add_checkbox() {
    local item="$1"
    in_list "$item" "${checked[@]}" && echo "$CHECKED_SYMBOL $item" || echo "$UNCHECKED_SYMBOL $item"
}

function print_list() {
    local row=
    for i in "${!items[@]}"; do
        row=$(add_checkbox "${items[i]}")
        [[ $i -eq $hover_idx ]] && highlight "$row" || echo "$row" > /dev/tty
    done
}

function parse_keypress() {
    local escape_prefix=$'\x1b'
    local up=$'[A'
    local down=$'[B'
    IFS= read -r -s -n1 key
    case "$key" in
        "k"|"K")
            echo "up"
            ;;
        "j"|"J")
            echo "down"
            ;;
        "q"|"Q")
            echo "exit"
            ;;
        " ")
            echo "space"
            ;;
        "")
            echo "enter"
            ;;
        # Handle up/down keys by reading prefixed escape keys.
        $escape_prefix)
            read -r -s -n2 -t 0.05 next_chars
            case $next_chars in
                $up)
                    echo "up"
                    ;;
                $down)
                    echo "down"
                    ;;
            esac
            ;;
    esac
}

#==========================================#
# Parse arguments, leaving the menu items. #
#==========================================#

while [[ $# -gt 0 ]]; do
    case $1 in
        # Default behaviour, but for explicity.
        -c|--checked)
            return_unchecked=1
            shift 1
            ;;
        -u|--unchecked)
            return_unchecked=0
            shift 1
            ;;
        -a|--check-all)
            check_all=0
            shift 1
            ;;
        -*|--*)
            echo "Unknown option $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

#============================================#
# Handle if no items are given for the list. #
#============================================#

if [[ $# -eq 0 ]]; then
    echo "Error: Items for the list is required." >&2
    exit 1
fi

#========#
# Setup. #
#========#

# Hide terminal cursor.
#tput civis

# Restore cursor on exit.
#trap 'tput cnorm; exit' INT TERM EXIT

items=("$@")
[[ $check_all -eq 0 ]] && checked=("${items[@]}") || unchecked=("${items[@]}")

#=================#
# Selection loop. #
#=================#

selection_complete=1
rows_count=$((${#items[@]} + 1))
key=
while [[ $selection_complete -eq 1 ]]; do
    print_list
    # Pauses loop, waiting for input.
    key=$(parse_keypress)
    if [[ "$key" == "exit" ]]; then 
        exit 0
    elif [[ $key =~ ^(up|down)$ ]]; then
        shift_hover_idx "$key"
    elif [[ $key == "space" ]]; then
        add_remove_selection 
    elif [[ $key == "enter" ]]; then
        selection_complete=0
        break
    fi
    # Prepare redraw; move cursor to top of list.
    echo -e "\033[${rows_count}A" > /dev/tty
done

[[ $return_unchecked -eq 0 ]] && echo "${unchecked[@]}" || echo "${checked[@]}"

exit 0
