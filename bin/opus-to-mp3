#!/usr/bin/env bash

#
# Convert .opus file to .mp3 and preserve the cover art.
# 
# How:
# In .opus files generated by `yt-dlp` config script, the cover art is applied
# as a video-stream in the OGG container. This image is then ripped from the stream
# in .png format then applied the .mp3 in form of a metadata property.
#

if [[ ! -e $1 ]]; then
    echo "Error: file $1 not found"
    exit 1
elif [[ $1 != *.opus ]]; then
    echo "Error: file $1 is not an opus file (used extensions to check filetype)."
    exit 1
fi

ffmpeg \
    -i "$1" \
    -map 0:a \
    -map 0:v? \
    -c:a libmp3lame \
    -q:a 0 \
    -c:v:0 png \
    -id3v2_version 3 \
    -metadata:s:t mimetype=image/jpeg \
    -metadata:s:v title="Album cover" \
    -metadata:s:v comment="Cover (Front)" \
    "${file%.opus}.mp3"
