#!/usr/bin/env bash

#
# Decide what Waybar config and style to use, depending if the system is a desktop or not.
# E.g; use a config without battery module for desktops.
#
# TODO:
# This is obviously unmaintainable and should be fixed...
#

if [[ $(hostnamectl chassis) == "desktop" ]]; then
    exec waybar --config /home/gobbls/.config/waybar/config.jsonc --style /home/gobbls/.config/waybar/style.css
else
    exec waybar --config /home/gobbls/.dotfiles.bak/home/waybar/config.jsonc --style /home/gobbls/.dotfiles.bak/home/waybar/style.css
fi
